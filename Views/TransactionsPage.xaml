<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projet_Budget_M1.Views.TransactionsPage"
             Title="Transactions"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header & Search -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="20,10">
            <Label Text="Transactions" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Frame Grid.Column="0" Padding="0" BackgroundColor="White" CornerRadius="12" HasShadow="False">
                    <Entry x:Name="SearchEntry" Placeholder="Rechercher une transaction..." BackgroundColor="Transparent" TextColor="#2C3E50" HeightRequest="45" TextChanged="OnSearchChanged" />
                </Frame>
                <Button Grid.Column="1" Text="＋" FontSize="20" WidthRequest="45" HeightRequest="45" CornerRadius="12" BackgroundColor="#2C3E50" TextColor="White" Clicked="OnAddClicked" />
            </Grid>
        </VerticalStackLayout>

        <!-- List -->
        <CollectionView Grid.Row="1" x:Name="TransactionsList" ItemsSource="{Binding}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="16,8" Padding="16" CornerRadius="16" HasShadow="True" BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="18" TextColor="#2C3E50" />
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                <Button Text="✏️" Padding="6" BackgroundColor="Transparent" Clicked="OnEditClicked" CommandParameter="{Binding .}" />
                                <Button Text="🗑️" Padding="6" BackgroundColor="Transparent" TextColor="#E74C3C" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12" VerticalOptions="Center">
                                <Frame Padding="8,4" CornerRadius="10" BackgroundColor="#ECF0F1" HasShadow="False">
                                    <Label Text="{Binding Category}" FontSize="12" TextColor="#2C3E50" />
                                </Frame>
                                <Label Text="{Binding Date, StringFormat='{}{0:dd MMM}'}" FontSize="12" TextColor="#7F8C8D" />
                                <Label Text="{Binding Amount, StringFormat='{}{0:+0.00;-0.00} €'}" FontSize="16" TextColor="#27AE60" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Menu Footer -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="0"
               HasShadow="True"
               Margin="0"
               BorderColor="#E0E0E0">
            <Grid ColumnDefinitions="*,*,*,*"
                  RowDefinitions="Auto"
                  Padding="8,10,8,10">

                <!-- Accueil -->
                <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="🏠"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Accueil"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Transactions -->
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💳"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTransactionsTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Transactions"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Statistiques -->
                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="📊"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatisticsTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Statistiques"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Budget (actif) -->
                <VerticalStackLayout Grid.Column="3"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💰"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap"
                               TextColor="#3498DB" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBudgetTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Budget"
                           FontSize="12"
                           TextColor="#3498DB"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Frame>
    </Grid>

</ContentPage>
