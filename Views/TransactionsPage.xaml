<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Projet_Budget_M1.Converters"
             x:Class="Projet_Budget_M1.Views.TransactionsPage"
             Title="Transactions"
             BackgroundColor="#F5F5F5">
    <ContentPage.Resources>
        <local:AmountToColorConverter x:Key="AmountToColorConverter" />
        <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header & Search -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="20,10">
            <Label Text="Transactions" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Frame Grid.Column="0" Padding="0" BackgroundColor="White" CornerRadius="12" HasShadow="False">
                    <Entry Placeholder="Rechercher une transaction..." BackgroundColor="Transparent" TextColor="#2C3E50" HeightRequest="45" Text="{Binding SearchText, Mode=TwoWay}" />
                </Frame>
                <Button Grid.Column="1" 
                        Text="{Binding SortButtonText}" 
                        FontSize="16" 
                        WidthRequest="45" 
                        HeightRequest="45" 
                        CornerRadius="12" 
                        BackgroundColor="#9B59B6" 
                        TextColor="White" 
                        Command="{Binding ToggleSortCommand}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="0" />
                <Button Grid.Column="2" 
                        Text="🔍" 
                        FontSize="18" 
                        WidthRequest="45" 
                        HeightRequest="45" 
                        CornerRadius="12" 
                        BackgroundColor="#3498DB" 
                        TextColor="White" 
                        Command="{Binding ToggleFilterPanelCommand}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="0" />
                <Button Grid.Column="3" 
                        Text="📄" 
                        FontSize="18" 
                        WidthRequest="45" 
                        HeightRequest="45" 
                        CornerRadius="12" 
                        BackgroundColor="#E67E22" 
                        TextColor="White" 
                        Command="{Binding ExportPdfCommand}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="0" />
                <Button Grid.Column="4" Text="＋" FontSize="20" WidthRequest="45" HeightRequest="45" CornerRadius="12" BackgroundColor="#2C3E50" TextColor="White" Command="{Binding AddTransactionCommand}" />
            </Grid>
            
            <!-- Panneau de filtres -->
            <Frame IsVisible="{Binding IsFilterPanelVisible}"
                   BackgroundColor="White"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="True"
                   Margin="0,8,0,0">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Filtres" FontSize="16" FontAttributes="Bold" TextColor="#2C3E50" />
                        <Button Grid.Column="1" 
                                Text="Réinitialiser" 
                                FontSize="12" 
                                TextColor="#E74C3C" 
                                BackgroundColor="Transparent" 
                                Command="{Binding ResetFiltersCommand}" />
                    </Grid>
                    
                    <!-- Filtre par catégorie -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Catégorie" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                        <Frame BackgroundColor="#ECF0F1" CornerRadius="10" Padding="12,0" HeightRequest="45" HasShadow="False">
                            <Picker ItemsSource="{Binding FilterCategories}" 
                                    SelectedItem="{Binding FilterCategory, Mode=TwoWay}"
                                    BackgroundColor="Transparent"
                                    TextColor="#2C3E50"
                                    FontSize="14" />
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Filtres par date -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Date début" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                            <Frame BackgroundColor="#ECF0F1" CornerRadius="10" Padding="12,0" HeightRequest="45" HasShadow="False">
                                <DatePicker Date="{Binding FilterDateStartValue, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            TextColor="#2C3E50"
                                            FontSize="14" />
                            </Frame>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Date fin" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                            <Frame BackgroundColor="#ECF0F1" CornerRadius="10" Padding="12,0" HeightRequest="45" HasShadow="False">
                                <DatePicker Date="{Binding FilterDateEndValue, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            TextColor="#2C3E50"
                                            FontSize="14" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>

        <!-- List -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding TransactionGroups}" SelectionMode="None" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Frame Margin="16,12,16,4" Padding="12,8" CornerRadius="10" BackgroundColor="#E8F4F8" HasShadow="False">
                        <Label Text="{Binding GroupName}" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#2C3E50" />
                    </Frame>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="16,4" Padding="16" CornerRadius="16" HasShadow="True" BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="18" TextColor="#2C3E50" />
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                <Button Text="✏️" Padding="6" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTransactionCommand}" CommandParameter="{Binding .}" />
                                <Button Text="🗑️" Padding="6" BackgroundColor="Transparent" TextColor="#E74C3C" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTransactionCommand}" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12" VerticalOptions="Center">
                                <Frame Padding="8,4" CornerRadius="10" BackgroundColor="#ECF0F1" HasShadow="False">
                                    <Label Text="{Binding Category}" FontSize="12" TextColor="#2C3E50" />
                                </Frame>
                                <Label Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="12" TextColor="#7F8C8D" />
                                <Label Text="{Binding Amount, StringFormat='{}{0:+0.00;-0.00} €'}" FontSize="16">
                                    <Label.TextColor>
                                        <Binding Path="Amount" Converter="{StaticResource AmountToColorConverter}" />
                                    </Label.TextColor>
                                </Label>
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Menu Footer -->
        <Frame Grid.Row="2"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="0"
               HasShadow="True"
               Margin="0"
               VerticalOptions="End"
               BorderColor="#E0E0E0">
            <Grid ColumnDefinitions="*,*,*,*"
                  RowDefinitions="Auto"
                  Padding="8,10,8,10">

                <!-- Accueil -->
                <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="🏠"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateHomeCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Accueil"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Transactions -->
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💳"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadDataCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Transactions"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Statistiques -->
                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="📊"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateStatisticsCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Statistiques"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Budget (actif) -->
                <VerticalStackLayout Grid.Column="3"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💰"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap"
                               TextColor="#3498DB" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateBudgetCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Budget"
                           FontSize="12"
                           TextColor="#3498DB"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Frame>

        <!-- Overlay pour le formulaire de transaction -->
        <Grid x:Name="OverlayGrid"
              Grid.Row="0"
              Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsOverlayVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped"/>
            </Grid.GestureRecognizers>
            
            <!-- Modal centré -->
            <Frame x:Name="TransactionFormFrame"
                   BackgroundColor="White"
                   CornerRadius="20"
                   Padding="0"
                   Margin="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="380"
                   MaximumWidthRequest="450"
                   MinimumWidthRequest="320"
                   HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFormFrameTapped"/>
                </Frame.GestureRecognizers>
                
                <Grid RowDefinitions="Auto,*" RowSpacing="0" InputTransparent="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFormFrameTapped"/>
                        </Grid.GestureRecognizers>
                        
                        <!-- Header bleu foncé -->
                        <Frame Grid.Row="0"
                               BackgroundColor="#2C3E50"
                               CornerRadius="20,20,0,0"
                               Padding="20,18"
                               Margin="0,0,0,0"
                               HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0"
                                        Text="✕"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        WidthRequest="35"
                                        HeightRequest="35"
                                        CornerRadius="17"
                                        Command="{Binding CloseOverlayCommand}" />
                                <Label Grid.Column="1"
                                       Text="{Binding FormTitle}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <!-- Colonne vide pour équilibrer -->
                                <BoxView Grid.Column="2" 
                                         WidthRequest="35"
                                         HeightRequest="35"
                                         BackgroundColor="Transparent" />
                            </Grid>
                        </Frame>

                        <!-- Contenu du formulaire -->
                        <ScrollView Grid.Row="1" 
                                   MaximumHeightRequest="600"
                                   VerticalScrollBarVisibility="Never">
                            <VerticalStackLayout Padding="25" Spacing="18">
                                
                                <!-- Champ Titre -->
                                <VerticalStackLayout Spacing="5">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Titre"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#2C3E50" />
                                        <Label Text="*"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#E74C3C" />
                                    </HorizontalStackLayout>
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="📝"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Entry Grid.Column="1"
                                                   Placeholder="Ex: Courses, Salaire..."
                                                   BackgroundColor="Transparent"
                                                   TextColor="#2C3E50"
                                                   PlaceholderColor="#95A5A6"
                                                   FontSize="16"
                                                   Text="{Binding Title, Mode=TwoWay}" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Champ Montant -->
                                <VerticalStackLayout Spacing="5">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Montant (€)"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#2C3E50" />
                                        <Label Text="*"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#E74C3C" />
                                    </HorizontalStackLayout>
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="💰"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Entry Grid.Column="1"
                                                   Text="{Binding Amount, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#2C3E50"
                                                   FontSize="16" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Champ Catégorie -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Catégorie"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50" />
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding CategoryIcon}"
                                                   FontSize="18"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Picker Grid.Column="1"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#2C3E50"
                                                    Title=""
                                                    FontSize="16"
                                                    ItemsSource="{Binding Categories}"
                                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                                            </Picker>
                                            <Label Text="▼"
                                                   Grid.Column="2"
                                                   FontSize="12"
                                                   TextColor="#7F8C8D"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End"
                                                   Margin="5,0,0,0" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Champ Date -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Date"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50" />
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <DatePicker Grid.Column="0"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#2C3E50"
                                                        FontSize="16"
                                                        Date="{Binding Date, Mode=TwoWay}" />
                                            <Label Text="📅"
                                                   Grid.Column="1"
                                                   FontSize="18"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Champ Budget -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Budget mensuel"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50" />
                                    
                                    <!-- Option: Créer un nouveau budget -->
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding CreateNewBudget, Mode=TwoWay}"
                                                      VerticalOptions="Center"
                                                      Margin="0,0,10,0" />
                                            <Label Grid.Column="1"
                                                   Text="Créer un nouveau budget"
                                                   FontSize="14"
                                                   TextColor="#2C3E50"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Frame>
                                    
                                    <!-- Sélecteur de budget existant (si pas de nouveau budget) -->
                                    <Frame IsVisible="{Binding CreateNewBudget, Converter={StaticResource InvertedBoolConverter}}"
                                           BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="💰"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Picker Grid.Column="1"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#2C3E50"
                                                    Title="Sélectionner un budget"
                                                    FontSize="16"
                                                    ItemsSource="{Binding AvailableBudgets}"
                                                    SelectedItem="{Binding SelectedBudget, Mode=TwoWay}"
                                                    ItemDisplayBinding="{Binding DisplayText}" />
                                        </Grid>
                                    </Frame>
                                    
                                    <!-- Champ limite pour nouveau budget (si création) -->
                                    <Frame IsVisible="{Binding CreateNewBudget}"
                                           BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent"
                                           Margin="0,5,0,0">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="💵"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Entry Grid.Column="1"
                                                   Placeholder="Limite du budget (optionnel)"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#2C3E50"
                                                   PlaceholderColor="#95A5A6"
                                                   FontSize="16"
                                                   Keyboard="Numeric"
                                                   Text="{Binding NewBudgetLimit, Mode=TwoWay}" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Boutons d'action -->
                                <Grid ColumnDefinitions="*,*" 
                                      ColumnSpacing="10"
                                      Margin="0,15,0,25">
                                    <Button Grid.Column="0"
                                            Text="Annuler"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#7F8C8D"
                                            BackgroundColor="#ECF0F1"
                                            CornerRadius="10"
                                            Padding="0,12"
                                            Command="{Binding CloseOverlayCommand}" />
                                    <Button Grid.Column="1"
                                            Text="Enregistrer"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="#2C3E50"
                                            CornerRadius="10"
                                            Padding="0,12"
                                            Command="{Binding SaveTransactionCommand}" />
                                </Grid>

                            </VerticalStackLayout>
                        </ScrollView>

                </Grid>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
