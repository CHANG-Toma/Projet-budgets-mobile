<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projet_Budget_M1.Views.StatisticsPage"
             Title="Statistiques"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*,Auto">
        <!-- Main Content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20" Padding="20">
                <Label Text="📊" FontSize="60" HorizontalOptions="Center" />
                <Label Text="Statistiques" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center" />
                <Label Text="Page en cours de développement" FontSize="16" TextColor="#7F8C8D" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Menu Footer -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="0"
               HasShadow="True"
               Margin="0"
               BorderColor="#E0E0E0">
            <Grid ColumnDefinitions="*,*,*,*"
                  RowDefinitions="Auto"
                  Padding="8,10,8,10">

                <!-- Accueil -->
                <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="🏠"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Accueil"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Transactions -->
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💳"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTransactionsTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Transactions"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Statistiques -->
                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="📊"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatisticsTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Statistiques"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Budget (actif) -->
                <VerticalStackLayout Grid.Column="3"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💰"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap"
                               TextColor="#3498DB" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBudgetTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Budget"
                           FontSize="12"
                           TextColor="#3498DB"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Frame>
    </Grid>

</ContentPage>
