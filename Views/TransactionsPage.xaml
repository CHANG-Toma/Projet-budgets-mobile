<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projet_Budget_M1.Views.TransactionsPage"
             Title="Transactions"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header & Search -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="20,10">
            <Label Text="Transactions" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Frame Grid.Column="0" Padding="0" BackgroundColor="White" CornerRadius="12" HasShadow="False">
                    <Entry Placeholder="Rechercher une transaction..." BackgroundColor="Transparent" TextColor="#2C3E50" HeightRequest="45" Text="{Binding SearchText, Mode=TwoWay}" />
                </Frame>
                <Button Grid.Column="1" Text="＋" FontSize="20" WidthRequest="45" HeightRequest="45" CornerRadius="12" BackgroundColor="#2C3E50" TextColor="White" Command="{Binding AddTransactionCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- List -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Transactions}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="16,8" Padding="16" CornerRadius="16" HasShadow="True" BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="18" TextColor="#2C3E50" />
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                <Button Text="✏️" Padding="6" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTransactionCommand}" CommandParameter="{Binding .}" />
                                <Button Text="🗑️" Padding="6" BackgroundColor="Transparent" TextColor="#E74C3C" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTransactionCommand}" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12" VerticalOptions="Center">
                                <Frame Padding="8,4" CornerRadius="10" BackgroundColor="#ECF0F1" HasShadow="False">
                                    <Label Text="{Binding Category}" FontSize="12" TextColor="#2C3E50" />
                                </Frame>
                                <Label Text="{Binding Date, StringFormat='{}{0:dd MMM}'}" FontSize="12" TextColor="#7F8C8D" />
                                <Label Text="{Binding Amount, StringFormat='{}{0:+0.00;-0.00} €'}" FontSize="16" TextColor="#27AE60" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Menu Footer -->
        <Frame Grid.Row="2"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="0"
               HasShadow="True"
               Margin="0"
               VerticalOptions="End"
               BorderColor="#E0E0E0">
            <Grid ColumnDefinitions="*,*,*,*"
                  RowDefinitions="Auto"
                  Padding="8,10,8,10">

                <!-- Accueil -->
                <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="🏠"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateHomeCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Accueil"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Transactions -->
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💳"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadDataCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Transactions"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Statistiques -->
                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="📊"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateStatisticsCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Statistiques"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Budget (actif) -->
                <VerticalStackLayout Grid.Column="3"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💰"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap"
                               TextColor="#3498DB" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateBudgetCommand}" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Budget"
                           FontSize="12"
                           TextColor="#3498DB"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Frame>

        <!-- Overlay pour le formulaire de transaction -->
        <Grid x:Name="OverlayGrid"
              Grid.Row="0"
              Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsOverlayVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped"/>
            </Grid.GestureRecognizers>
            
            <!-- Modal centré -->
            <Frame x:Name="TransactionFormFrame"
                   BackgroundColor="White"
                   CornerRadius="20"
                   Padding="0"
                   Margin="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="380"
                   MaximumWidthRequest="450"
                   MinimumWidthRequest="320"
                   HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFormFrameTapped"/>
                </Frame.GestureRecognizers>
                
                <Grid RowDefinitions="Auto,*" RowSpacing="0" InputTransparent="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFormFrameTapped"/>
                        </Grid.GestureRecognizers>
                        
                        <!-- Header bleu foncé -->
                        <Frame Grid.Row="0"
                               BackgroundColor="#2C3E50"
                               CornerRadius="20,20,0,0"
                               Padding="20,18"
                               Margin="0,0,0,0"
                               HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0"
                                        Text="✕"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        WidthRequest="35"
                                        HeightRequest="35"
                                        CornerRadius="17"
                                        Command="{Binding CloseOverlayCommand}" />
                                <Label Grid.Column="1"
                                       Text="{Binding FormTitle}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <!-- Colonne vide pour équilibrer -->
                                <BoxView Grid.Column="2" 
                                         WidthRequest="35"
                                         HeightRequest="35"
                                         BackgroundColor="Transparent" />
                            </Grid>
                        </Frame>

                        <!-- Contenu du formulaire -->
                        <ScrollView Grid.Row="1" 
                                   MaximumHeightRequest="600"
                                   VerticalScrollBarVisibility="Never">
                            <VerticalStackLayout Padding="25" Spacing="18">
                                
                                <!-- Champ Titre -->
                                <VerticalStackLayout Spacing="5">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Titre"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#2C3E50" />
                                        <Label Text="*"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#E74C3C" />
                                    </HorizontalStackLayout>
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="📝"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Entry Grid.Column="1"
                                                   Placeholder="Ex: Courses, Salaire..."
                                                   BackgroundColor="Transparent"
                                                   TextColor="#2C3E50"
                                                   PlaceholderColor="#95A5A6"
                                                   FontSize="16"
                                                   Text="{Binding Title, Mode=TwoWay}" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Champ Montant -->
                                <VerticalStackLayout Spacing="5">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Montant (€)"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#2C3E50" />
                                        <Label Text="*"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#E74C3C" />
                                    </HorizontalStackLayout>
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="💰"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Entry Grid.Column="1"
                                                   Text="{Binding Amount, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#2C3E50"
                                                   FontSize="16" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Champ Catégorie -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Catégorie"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50" />
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding CategoryIcon}"
                                                   FontSize="18"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0" />
                                            <Picker Grid.Column="1"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#2C3E50"
                                                    Title=""
                                                    FontSize="16"
                                                    ItemsSource="{Binding Categories}"
                                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                                            </Picker>
                                            <Label Text="▼"
                                                   Grid.Column="2"
                                                   FontSize="12"
                                                   TextColor="#7F8C8D"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End"
                                                   Margin="5,0,0,0" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Champ Date -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Date"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50" />
                                    <Frame BackgroundColor="#ECF0F1"
                                           CornerRadius="10"
                                           Padding="15,0"
                                           HeightRequest="50"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <DatePicker Grid.Column="0"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#2C3E50"
                                                        FontSize="16"
                                                        Date="{Binding Date, Mode=TwoWay}" />
                                            <Label Text="📅"
                                                   Grid.Column="1"
                                                   FontSize="18"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Boutons d'action -->
                                <Grid ColumnDefinitions="*,*" 
                                      ColumnSpacing="10"
                                      Margin="0,15,0,25">
                                    <Button Grid.Column="0"
                                            Text="Annuler"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#7F8C8D"
                                            BackgroundColor="#ECF0F1"
                                            CornerRadius="10"
                                            Padding="0,12"
                                            Command="{Binding CloseOverlayCommand}" />
                                    <Button Grid.Column="1"
                                            Text="Enregistrer"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="#2C3E50"
                                            CornerRadius="10"
                                            Padding="0,12"
                                            Command="{Binding SaveTransactionCommand}" />
                                </Grid>

                            </VerticalStackLayout>
                        </ScrollView>

                </Grid>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
