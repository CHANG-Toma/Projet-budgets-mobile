<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projet_Budget_M1.Views.StatisticsPage"
             Title="Statistiques"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <ActivityIndicator Grid.Row="0"
                           Grid.RowSpan="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#3498DB"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,10" Spacing="18">
                <Label Text="Statistiques"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#2C3E50" />
                <Label Text="{Binding CurrentMonthLabel}"
                       FontSize="14"
                       TextColor="#7F8C8D" />

                <!-- Resume -->
                <Frame BackgroundColor="White"
                       CornerRadius="16"
                       Padding="18"
                       HasShadow="True">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                            <Label Text="Depenses du mois" FontSize="13" TextColor="#7F8C8D" />
                            <Label Text="{Binding CurrentMonthExpensesText}" FontSize="20" FontAttributes="Bold" TextColor="#E74C3C" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                            <Label Text="Revenus du mois" FontSize="13" TextColor="#7F8C8D" />
                            <Label Text="{Binding CurrentMonthIncomeText}" FontSize="20" FontAttributes="Bold" TextColor="#27AE60" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                            <Label Text="Transactions du mois" FontSize="13" TextColor="#7F8C8D" />
                            <Label Text="{Binding CurrentMonthTransactionsCountText}" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                            <Label Text="Salaire (categorie)" FontSize="13" TextColor="#7F8C8D" />
                            <Label Text="{Binding SalaryCategoryAmountText}" FontSize="16" FontAttributes="Bold" TextColor="#2C3E50" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Repartition categories -->
                <Border BackgroundColor="Transparent"
                        Stroke="#DDE3EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Top categories (mois courant)"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#2C3E50" />

                        <Label Text="{Binding TopCategoriesSummaryText}"
                               FontSize="14"
                               TextColor="#2C3E50"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Evolution -->
                <Frame BackgroundColor="White"
                       CornerRadius="16"
                       Padding="18"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Evolution des 6 derniers mois"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#2C3E50" />

                        <Label Text="{Binding MonthlyTrendSummaryText}"
                               FontSize="14"
                               TextColor="#2C3E50"
                               LineBreakMode="WordWrap" />

                        <!-- Graphique barres -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MonthlyTrend}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding MonthShort}"
                                               FontSize="13"
                                               TextColor="#2C3E50"
                                               WidthRequest="58"
                                               VerticalOptions="Center" />

                                        <Grid Grid.Column="1"
                                              HeightRequest="10"
                                              BackgroundColor="#ECF0F1"
                                              VerticalOptions="Center"
                                              HorizontalOptions="Fill">
                                            <BoxView WidthRequest="{Binding BarWidth}"
                                                     HeightRequest="10"
                                                     Color="#3498DB"
                                                     HorizontalOptions="Start"
                                                     VerticalOptions="Center" />
                                        </Grid>

                                        <Label Grid.Column="2"
                                               Text="{Binding AmountText}"
                                               FontSize="12"
                                               TextColor="#7F8C8D"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Menu Footer -->
        <Frame Grid.Row="2"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="0"
               HasShadow="True"
               Margin="0"
               BorderColor="#E0E0E0">
            <Grid ColumnDefinitions="*,*,*,*"
                  RowDefinitions="Auto"
                  Padding="8,10,8,10">

                <!-- Accueil -->
                <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="🏠"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Accueil"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Transactions -->
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💳"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTransactionsTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Transactions"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Statistiques (actif) -->
                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="📊"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap"
                               TextColor="#3498DB" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatisticsTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Statistiques"
                           FontSize="12"
                           TextColor="#3498DB"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Budget -->
                <VerticalStackLayout Grid.Column="3"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Frame WidthRequest="72"
                           HeightRequest="72"
                           CornerRadius="36"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Label Text="💰"
                               FontSize="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap" />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBudgetTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Label Text="Budget"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Frame>
    </Grid>

</ContentPage>
